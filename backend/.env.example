# Copy this to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL unset to use a local SQLite file. Docker Compose sets Postgres for you.
# DATABASE_URL=postgres://accesspath:accesspath@localhost:5432/accesspath
REDIS_URL=redis://localhost:6379/0

# Local S3 is MinIO from docker-compose. In AWS, remove S3_ENDPOINT_URL.
S3_BUCKET=accesspath-dev
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Purdue GenAI Studio. Put your real key only in .env, never in this example.
GENAI_API_KEY=
GENAI_TEXT_MODEL=gpt-oss:120b
GENAI_VISION_MODEL=gemma4:26b-a4b
# Use vllm for the default models above; Ollama-hosted models require ollama.
GENAI_BACKEND=vllm

# Legacy Anthropic settings: retained for shared settings compatibility.
# These are unused by the Purdue pipeline; coordinate removal with Engineer A.
# ANTHROPIC_API_KEY=
LLM_STRONG_MODEL=claude-sonnet-5-5
LLM_CHEAP_MODEL=claude-haiku-5-5
